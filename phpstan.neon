# Child-owned PHPStan overlay loaded after phpstan.neon.dist.

parameters:
  excludePaths:
    - lib

  ignoreErrors:
    -
      identifier: class.notFound
      message: '#WC_Email|WC_Order|WC_Order_Item_Product|WC_Product|XLSXWriter#'
    -
      identifier: function.notFound
      message: '#wc_get_product#'
    -
      identifier: return.unusedType
    -
      identifier: instanceof.alwaysTrue
